PORT=3001

# ── FLOW MODE ─────────────────────────────────────────────────
# mock    → No credentials. Returns local test files. Use first.
# browser → Headless Chrome with injected cookie. This is the only
#           mode that works with Flow (reCAPTCHA requires real browser)
# api     → NOT SUPPORTED (reCAPTCHA blocks all direct HTTP calls)
FLOW_MODE=browser

# ── SESSION COOKIE ────────────────────────────────────────────
# Required for browser mode.
# Run: npm run capture → log in → generate something
# The script auto-saves the cookie here.
FLOW_SESSION_COOKIE=

# ── REDIS ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── MISC ──────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-secret-string
MOCK_DELAY_IMAGE=4000
MOCK_DELAY_VIDEO=8000
