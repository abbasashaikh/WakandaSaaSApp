# ============================================================
# POC Backend — Environment Configuration
# Copy this to .env and fill in your values
# ============================================================

PORT=3001
FLOW_MODE=browser

# ─── FLOW MODE ───────────────────────────────────────────────
# mock    → No credentials needed. Returns fake URLs. Chrome never opens.
#           USE THIS FIRST to verify the full stack works.
# browser → Headless Chrome uses your session cookie to call Flow's API.
# api     → Axios calls Flow's tRPC API directly with your session cookie.

# ─── FLOW URL ────────────────────────────────────────────────
# Google Labs Flow (NOT flow.so)
FLOW_BASE_URL=https://labs.google/fx/tools/flow
FLOW_TRPC_BASE=https://labs.google/fx/api/trpc

# ─── SESSION COOKIE (required for browser + api modes) ───────
# How to get this:
#   1. Run: node scripts/investigateFlow.js
#   2. A visible Chrome opens → click "Sign in with Google"
#   3. Complete Google login in the browser window
#   4. The script prints authCookies at the end
#   5. Copy the value of next-auth.session-token
#   6. Paste it below (no quotes needed)
FLOW_SESSION_COOKIE=eyJhbGciOiJkaXIiLCJlbmMiOiJBMjU2R0NNIn0..A47Ci38rjiF75Urr.CuCfO934ZRUQf1V5QGEH2ILQiVsCv2Do07EFNzLMzmADg0VKOd9LPCV_fc4GrylYuPFieRTMv8KCypwt9tRGZHzEKZteqzM7y2DB62xJKKtD-fRTbbfVXsWDw-nY0Ow8uMDcGpaO2kkBP6GIxSvkHAXinSSSaF2Kz82b3ll73F2hf7bmBwASIBVcxXmBoZoTvyKvHmjk6dBioeQygXHpu2LiMIR9llQ_I0A8RUk1QfzWPNpofybFk7lScB8z4snos3Q-588Cj7KF5BiI7Vjxv0isR6Pr6VqFuuXVKq4Nz-z2k8E0T1gARKSNGfZq1SzYBGIJusL4N1ynse-S4pxdiosqKPi8d8kyZK-QDQ-1MNgXG1RjP_g3-vn9nSIYiZfb9EIus361A1_EOu89pmx4_fPmtsIMzDrOMB6QS5vohRCelxOXmo9y0DIUF95EXTOe8oYyafGSLWvjSynE41XanpbxGCetPzGrT4TaWkyhig8UE8Ap8orlM3PyXn2WOIsi2QgT-5ZxJVrWUHRu3QZRiMkvo6JQEul6sO4RwpoDEyaiXauEdJh7cM2UmgkECY2hMpK77QCwKZ7Bt1_HVdXHdX-wUFBTf63m-XU76Rj-yY2pSv1y7eZOL_b6oc2BHL3pEoh-tK_o2uSrjTegGwf4lbLEEw5KEY8-iikzIga5cMKU3HjrG1qAnT0Kb7srRmrzwJAzflD3JoIHCmEFgAsLIxFbk9mGNfDCgguyA65_vS_KRJZeXgZ-Y41hdWKQsndjbMfYdaxroByedOPpUpPGQbggN0pmQErQ3c9nRyYZhRdXi95llztv9ZELRlNqhaqvmvkQ6r9-FC8OS7RJCoVx4Q23CCb-glHKrc4Wjvzv7AA5GWK-bdb4yOf_6jaK71H2RHOPNG74kS1A-AbbI40wlu2Gqn-KhYQ8F12Oidw40vpDnOUlt53Ntc2ZN_D1Bop3jLZqTgmFWPWF7NjdMmROd2dI5APaEfGgc4hihu4.vzPUnGggGW_Zfnr3x6J8Lw

# ─── tRPC PROCEDURE NAMES ────────────────────────────────────
# ⚠️  UPDATE AFTER running investigateFlow.js and generating something
# Look in flow-api-report.json → generationRequests[0].url
# The procedure name is the last part of the URL path
# e.g. https://labs.google/fx/api/trpc/image.generateImage
#                                        ^^^^^^^^^^^^^^^^^^^ this part
TRPC_IMAGE_PROC=NEEDS_INVESTIGATION
TRPC_VIDEO_PROC=video.generateVideo

# ─── REDIS ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── MISC ────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-secret-string

# Mock mode delays (ms) — how long to pretend generation takes
MOCK_DELAY_IMAGE=4000
MOCK_DELAY_VIDEO=8000
TRPC_IMAGE_PROC=project.createProject
