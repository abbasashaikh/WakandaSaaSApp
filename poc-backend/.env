# ============================================================
# POC Backend — Environment Configuration
# Copy this to .env and fill in your values
# ============================================================

PORT=3001
FLOW_MODE=browser

# ─── FLOW MODE ───────────────────────────────────────────────
# mock    → No credentials needed. Returns fake URLs. Chrome never opens.
#           USE THIS FIRST to verify the full stack works.
# browser → Headless Chrome uses your session cookie to call Flow's API.
# api     → Axios calls Flow's tRPC API directly with your session cookie.

# ─── FLOW URL ────────────────────────────────────────────────
# Google Labs Flow (NOT flow.so)
FLOW_BASE_URL=https://labs.google/fx/tools/flow
FLOW_TRPC_BASE=https://labs.google/fx/api/trpc

# ─── SESSION COOKIE (required for browser + api modes) ───────
# How to get this:
#   1. Run: node scripts/investigateFlow.js
#   2. A visible Chrome opens → click "Sign in with Google"
#   3. Complete Google login in the browser window
#   4. The script prints authCookies at the end
#   5. Copy the value of next-auth.session-token
#   6. Paste it below (no quotes needed)
FLOW_SESSION_COOKIE=eyJhbGciOiJkaXIiLCJlbmMiOiJBMjU2R0NNIn0..w5PLqfYoawVQnLj0.iAkNqi1V2_zx5NnCFtwdrOTH7pf_hEROjlvD466vxIWNCDadZypI4zR4TCYcUgafeks9Hjs_PVOCs4WG2y8briN3Rbx0pcP0ykOvRHW9K2TCX-9aC-8tyGLrf7_8gyhrPf0uBjPKM8SpfxWzlJU0KlYIg4NbLMlFLvRP3Cm52TXuXcvqA0I2mfSocmNDCOBNx2h3b5D3XPES6XcLlWbSP2xHrs21DoOAXmJGHoneeiVQ0vqm9tclZE9WsR3akF_iHTs2sp8vYAN89g4JgBC-H0SSa8B20CXJu_q9qr1XpyYFchnOE10dZxy42ssnIbNSFmIOBcLkMQ9Orv-j0Oz8cZbtEw8L6Qn4xkrUEcp43ONX3qHFyBCTu2bks8orfukobdTXnWerW0dQlayRwtj0cZhYlQ_rUhLwBxpfzIeYSI-CAmGwP2aM1ipg0QlrsTh42AWnk_0gNzBrCXwaaMCTeor5-RnHKFJvbI4OXoydTUPGSP4c2NcKKCevPKIORmggHLBWs2dURpHvmuNE40ss89UbyOWu_OOSHMP0nw2APwok1cXNd5z2_AOdIhC2ne7FjFtf4tq1Ufx3ZWlNEaC6pgkgIC534zCkHDPJeTi4-TCzABveDFI81UNWVQZTYeYC8ej7doZ3Ee1eJDD56RwYXp3DHq1FJswBGDUsSRY_isTZ_ZAJdIa-wAJxfio2-zMNki_lDQGKzm3MN5PrxCo2tHQl5UnjyRmcwzXQrN6mjOU2FO0Th2lLQyxphKdNV4ha8OATgd8zYS5nEKOvlZf1h_CuDgMPjzZvTCHOFDAE_WwXm5gm5orhSfaMpMcEt5UAEeQGf_gCkIO1gNUAfOmpBbv9UtB1wnDiGjhwC7BwaFYD2z8KbDLK-_9GayJgwRK5VriUZO1Z-vTY-p4BD4DrWWerAbMvmk3X-E6iBFbFjKQMNIYbRthtpQ2xsehbJh5n-_7BR3yTCmp27TiidRAjL10.ntUKsmKF_5wPqT1QMVwbwg

# ─── tRPC PROCEDURE NAMES ────────────────────────────────────
# ⚠️  UPDATE AFTER running investigateFlow.js and generating something
# Look in flow-api-report.json → generationRequests[0].url
# The procedure name is the last part of the URL path
# e.g. https://labs.google/fx/api/trpc/image.generateImage
#                                        ^^^^^^^^^^^^^^^^^^^ this part
TRPC_IMAGE_PROC=NEEDS_INVESTIGATION
TRPC_VIDEO_PROC=video.generateVideo

# ─── REDIS ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── MISC ────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-secret-string

# Mock mode delays (ms) — how long to pretend generation takes
MOCK_DELAY_IMAGE=4000
MOCK_DELAY_VIDEO=8000
TRPC_IMAGE_PROC=project.createProject
