# ============================================================
# POC Backend — Environment Configuration
# Copy this to .env and fill in your values
# ============================================================

PORT=3001
FLOW_MODE=browser

# ─── FLOW MODE ───────────────────────────────────────────────
# mock    → No credentials needed. Returns fake URLs. Chrome never opens.
#           USE THIS FIRST to verify the full stack works.
# browser → Headless Chrome uses your session cookie to call Flow's API.
# api     → Axios calls Flow's tRPC API directly with your session cookie.

# ─── FLOW URL ────────────────────────────────────────────────
# Google Labs Flow (NOT flow.so)
FLOW_BASE_URL=https://labs.google/fx/tools/flow
FLOW_TRPC_BASE=https://labs.google/fx/api/trpc

# ─── SESSION COOKIE (required for browser + api modes) ───────
# How to get this:
#   1. Run: node scripts/investigateFlow.js
#   2. A visible Chrome opens → click "Sign in with Google"
#   3. Complete Google login in the browser window
#   4. The script prints authCookies at the end
#   5. Copy the value of next-auth.session-token
#   6. Paste it below (no quotes needed)
FLOW_SESSION_COOKIE=eyJhbGciOiJkaXIiLCJlbmMiOiJBMjU2R0NNIn0..z7N9eFcPKOWRqLRz.t3m-SNnD5BXREoBam88vttq4tC_71BCQYyVv6T0pdwUc302FvZzAbcaAmNtw62VOsZH6DZqd_L_wV9LkLAevqPmxZR90w4wXiDQ81g7aOC4hH4lHGtmVYvzqUXhj9I8qlYln7lmvJixpWX27isPb8itzyrgZzeqcGf-MJ5KGqBTsOOiewei6piZ5pBU5f0drHgiauJ1Uho0U32DQbK8yT74hDgCeO4ZdBAOEV50kS3avcPWAhmvbZJnPcnIP4yKVob1E5DliDslbdDfuBAEXVbGiOUebtP8DRe3pwgFGOvOM_9KFKDRzHvLqmKeIPChqO35jKmBI4t0ioe3wXzIftNLviNhpIuRCh60RwZy056J_IO_WK4O7JptZmrcPABAT1Q8HkMPOqZSNa1W1hn0aLAxAhE8q9mylfVqyzZx88Puoatf5BihazIzon3RC_maPD6aMhuGmGEJedh_NpySjuaCbetWk5DkDrOrFpohEPCJ6nzXgJzlcTLUT9erNbpSVJoINxotwF0n1b7kkmeAN1qNNYeylt-pU30MiCkZfX5v67N5EL0K3IrYYlH4IrG3yCVItKM8w-jj4Kb5_wq9o-qJTf_llahWuxHIf6WindDQvDO4Zp16FcoYCbIMIJNyceTXNIXPs3gjI8V80-0V4ch3wn2LYxhHEdndw6EGH6cNgDrzH6o57HZEEG8vvCU5numGElIQQFfNd_GjnL7tcM7XTAyp3gH7tUMfWtoGmdUUFprH8QD1Eo89mMEWgyYDzmVn7xsGsA2vh_QmHrvOpgVL8sRUMkkWSAcATAKLHFcltjXs_sfw3oJD3pv3OEVe2kqqdhXj9Cv4HePWq0k9paaNMqFIsUePmiwOt0Do67tEwOOi8Z1GO4kVNnEdI6d5cp5caB-Gk4JFIcY2R0daaT4soQrBPp1Qy_PSyjWpDT1ARt3700LN4No2OTE1uSqNuSPYeXh_xVxXZw3eeUEHTdgxbaDU92KJmce6hTZpfkgQ.kNv1xtpApfpVzM74rSxmGw

# ─── tRPC PROCEDURE NAMES ────────────────────────────────────
# ⚠️  UPDATE AFTER running investigateFlow.js and generating something
# Look in flow-api-report.json → generationRequests[0].url
# The procedure name is the last part of the URL path
# e.g. https://labs.google/fx/api/trpc/image.generateImage
#                                        ^^^^^^^^^^^^^^^^^^^ this part
TRPC_IMAGE_PROC=NEEDS_INVESTIGATION
TRPC_VIDEO_PROC=video.generateVideo

# ─── REDIS ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── MISC ────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-secret-string

# Mock mode delays (ms) — how long to pretend generation takes
MOCK_DELAY_IMAGE=4000
MOCK_DELAY_VIDEO=8000
TRPC_IMAGE_PROC=project.createProject
