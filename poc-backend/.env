# ============================================================
# POC Backend — Environment Configuration
# Copy this to .env and fill in your values
# ============================================================

PORT=3001
FLOW_MODE=browser

# ─── FLOW MODE ───────────────────────────────────────────────
# mock    → No credentials needed. Returns fake URLs. Chrome never opens.
#           USE THIS FIRST to verify the full stack works.
# browser → Headless Chrome uses your session cookie to call Flow's API.
# api     → Axios calls Flow's tRPC API directly with your session cookie.

# ─── FLOW URL ────────────────────────────────────────────────
# Google Labs Flow (NOT flow.so)
FLOW_BASE_URL=https://labs.google/fx/tools/flow
FLOW_TRPC_BASE=https://labs.google/fx/api/trpc

# ─── SESSION COOKIE (required for browser + api modes) ───────
# How to get this:
#   1. Run: node scripts/investigateFlow.js
#   2. A visible Chrome opens → click "Sign in with Google"
#   3. Complete Google login in the browser window
#   4. The script prints authCookies at the end
#   5. Copy the value of next-auth.session-token
#   6. Paste it below (no quotes needed)
FLOW_SESSION_COOKIE=eyJhbGciOiJkaXIiLCJlbmMiOiJBMjU2R0NNIn0..X0Pb9b66jZmwOo8A.DxRP8aE6m4SwyGi8NT-1MTRpNcv6Ll1MWQeQy1TBH1CF6-YgsItDHOzb6jN1d1l4pzEgml3J1nMbCRswdWih-PC3B4UaNkPYA1q5LB36k8Rp82RFYAJEZqq3Oybq7pwpWUz0RMOZPenBkOBvtEe-w_0lbgDBgn56bPLwlGLrXLupe0oqXmfUnYbttnBopTLAx-Zqn16V1LvnPaxRPcCfYcMYnvKSFomTgMmKIllH2SFE_85DPP36ZAjR6bTmbhb2DTQGn8vqVGhYMqda-dwehm7ijaTTKqlXhofNBF5q-r3TVriE8W74yzdQIY4IZbJsP9IU90TzpMQ7GT3UhPZlVntTxq197IhhNYP2kajf7M6OnIhJmIoM96oYZ60un-A8Nf-TNcc9FnKkdxGUsiwUFqA27W6kNuWcP0jdG-s9PaeJZFHDbjFAuAp1JPmPTFcH2KvRVok2WroywiZAhow52h2mjWl6nA0fz0tyab9Qb_pcch8L6QYyluEQh7jI9FrZEAHRYXQ83nDvcuq5rcrDjRSG4idr1Cus1YpehFHPK4aM9RXll0ibXiR3R1rY9w0mpzWsCpbSWhUNhrROL_ATsAbJAop-TfPdbvfi0uPmA0UMdKY5C0foCkgqXwsG9FtoDAqP6X5DvcSxHcWSWCTqbsaquHmRZt_33IG-x-YPs30FWJqM8sdSea5_SUracq_xiaCtOwRn2EZzOH0lKbMqfYPPZ7a9Zg1JDYVVtE8mz8HvyCQY16vBxHPHBrGURG4gXkdmapDGbVpSov-6b_eVBRgJW4enuufQmTnbx9u9PFDwbH_yjy05k-gKz55VJy6syALjKq-7T9mzEkv5IQ.60EQMt8HfoX6WSyXRYr2Hg

# ─── tRPC PROCEDURE NAMES ────────────────────────────────────
# ⚠️  UPDATE AFTER running investigateFlow.js and generating something
# Look in flow-api-report.json → generationRequests[0].url
# The procedure name is the last part of the URL path
# e.g. https://labs.google/fx/api/trpc/image.generateImage
#                                        ^^^^^^^^^^^^^^^^^^^ this part
TRPC_IMAGE_PROC=NEEDS_INVESTIGATION
TRPC_VIDEO_PROC=video.generateVideo

# ─── REDIS ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── MISC ────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-secret-string

# Mock mode delays (ms) — how long to pretend generation takes
MOCK_DELAY_IMAGE=4000
MOCK_DELAY_VIDEO=8000
TRPC_IMAGE_PROC=project.createProject
