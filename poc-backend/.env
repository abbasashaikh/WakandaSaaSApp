
#-------------from .env.exmple----------------
# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
FLOW_MODE=browser
NODE_ENV=production          # 'development' for local, 'production' for server

# ── Browser mode ──────────────────────────────────────────────────────────────
# Set to 'false' for local dev to see the Chrome window.
# MUST be 'true' (or omitted) on any server — no display available.
HEADLESS=true

# ── Google Flow session cookie ────────────────────────────────────────────────
# Run: node scripts/captureSession.js   to get this value.
# Expires every ~7 days — re-capture before load testing.
FLOW_SESSION_COOKIE=eyJhbGciOiJkaXIiLCJlbmMiOiJBMjU2R0NNIn0..TXS4YMEzX1Rlq0m1.DJnET2suWaWNL35T39La7vskuPIoQzevfKbF7dHCuPN3cC7OnueiM6Pvm2i9DiECMKzz1TF34VV9h5POvLisd1OZiMDhD0kngPUSYKeaPonM_tg7c8tN6IxG4P12bjx7iTa0IS4DSBuxfg0oaj1AYOBwvLR_lOqfyhooOcCrxFDHLXOtnLxH3ALn1kmek6_gEsaTbUdEsoiWF2igpJML9OfzmLMxTZhz8xWDQ1S7GVZAt8lDro38LKCSwNbDNWJW0AbcXXSlMkFLYvfuzJojWJnvcTjzoj73mIx4rxdvGi0bNxeKz_28m_gbRuGoA-9FlstNCu4O2jt8evUoyyeSuKK7143L4oVYVqIN1blohJazcgW-FDlB2fG-i4-Axbh2OvaGSwQtCtFvIjES6-0OGqvKhmXs7grFyEDZ65gcmj6698fKvI6WeEkg-lP_duPTCT-XGdIRta6qr7kf8A_x5P5DlX1LPFsStcUKU20Jkn6loLW0QYPWTTo8wfY64BlDs9J8N8pH1_VigN695YcbWzWqVOUfGFeAG7GfYV_hJGZssv4bov1FjlZK8bNXeLgO8SeH2Qy7o_Li_o8xU0kKJu0dRuao6BGhKVTpB4xiQPp0R6-lxhJEIcemCkO48feEtYrCtuGSIq7T9Z81upG7ObhHuh3gsqOYatg9XSWjHbRLDhdc10DobVi5qrtEyZFB8shHyNf-kKyQ7ZRVMtUzoz4Filq3s2SfSTRT7EEJUl8A88ARYeLtyGqpH4ptmZH-FvAw7OnWt741g7ll5kry8dWGmSs_SI0tCPg8zGOks5qgl6-UnpyCiRczLdlY9tFXxTuNrc8TcR9Q0Vpxf5iSbMxPH9g0avzJjzn7qIy3nKjO4bixshO003TE-ckYnurA-GQihKe8DWuFxYtF1fdlOIv9NFcYCtUzMk91PmMQN8HgD7O85N5Lzlrw1a0R_5muDFkWsZmqtgZCRR0O6G7BCFYvooZUQ5a9Yo7F5oBP9Js.qOSyJnNk5dCPCP2gMn5tUg

# ── Redis ─────────────────────────────────────────────────────────────────────
# Requires Redis 6.2+. Default: local Redis on standard port.
REDIS_URL=redis://127.0.0.1:6379
# Optional Redis password if your instance requires auth:
# REDIS_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────────────
# MUST be a random string, 32+ characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_real_random_string_here
ACCESS_TOKEN_TTL_SEC=3600      # 1 hour
REFRESH_TOKEN_TTL_SEC=604800   # 7 days

# ── Browser pool ──────────────────────────────────────────────────────────────
# How many concurrent generation jobs to run simultaneously.
# Each slot uses ~300-500MB RAM in headless mode.
# Recommended per available RAM:
#   4GB RAM  → BROWSER_POOL_SIZE=2
#   8GB RAM  → BROWSER_POOL_SIZE=4
#   16GB RAM → BROWSER_POOL_SIZE=8
BROWSER_POOL_SIZE=2

# ── Rate limiting ─────────────────────────────────────────────────────────────
MIN_GEN_GAP_MS=5000            # Minimum ms between generations per user

# ── Credit monitoring ─────────────────────────────────────────────────────────
# Log a warning when credits drop below this threshold
CREDIT_WARN_THRESHOLD=500
# Log a critical alert when credits drop this low
CREDIT_CRITICAL_THRESHOLD=50

# ── Database ──────────────────────────────────────────────────────────────────
# Default: SQLite file in project root. Good for single-server deployments.
DB_PATH=./poc.db
